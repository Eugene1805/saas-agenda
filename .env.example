# Plantilla de variables para Docker Compose multitenant (copiar a `.env` local; nunca versionar `.env`)

POSTGRES_NORTE_DB=vital_agenda_norte
POSTGRES_NORTE_USER=vital_agenda_norte
POSTGRES_NORTE_PASSWORD=CHANGE_ME_LOCAL_NORTE_PG_PASS

POSTGRES_VALLE_DB=vital_agenda_valle
POSTGRES_VALLE_USER=vital_agenda_valle
POSTGRES_VALLE_PASSWORD=CHANGE_ME_LOCAL_VALLE_PG_PASS

POSTGRES_AURORA_DB=vital_agenda_aurora
POSTGRES_AURORA_USER=vital_agenda_aurora
POSTGRES_AURORA_PASSWORD=CHANGE_ME_LOCAL_AURORA_PG_PASS

# Clave HS256 compartida con saas-identity (minimo 32 bytes)
JWT_SIGNING_KEY=CHANGE_ME_LOCAL_HS256_KEY_AT_LEAST_32_BYTES

PLATFORM_MODE=Local
DIRECTORY_MODE=Local
ACCESS_CONTROL_MODE=Local

# En entornos locales de demo puedes activar SEED_DEMO_DATA=true sobre clinica-norte
SEED_DEMO_DATA=false
OPENAPI_ENABLED=true
